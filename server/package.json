{
  "name": "mern-todo-server",
  "version": "1.0.0",
  "description": "Backend API supporting Dual Databases (SQL & NoSQL/MongoDB) with JWT Auth & Data Migration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate:sql-to-mongo": "node scripts/migrate-sql-to-mongo.js",
    "migrate:mongo-to-sql": "node scripts/migrate-mongo-to-sql.js",
    "sync:both": "node scripts/sync-databases.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "pg": "^8.13.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
