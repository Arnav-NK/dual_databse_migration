# Server Port
PORT=5000

# Flag variable: 'true' for SQL (Neon PostgreSQL), 'false' for NoSQL (MongoDB Atlas)
USE_SQL=false

# Developer Migration Controls
# Secret Key required for HTTP migration API endpoints (pass in header: 'x-admin-key: <key>')
MIGRATION_SECRET=your_secure_developer_migration_secret

# Auto-migration on startup/redeploy: 'false', 'true', 'to-sql', 'to-mongo', 'sync'
AUTO_MIGRATE=false

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Atlas (NoSQL) Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/todolist_mern?retryWrites=true&w=majority

# Neon DB / PostgreSQL (SQL) Connection URI
DATABASE_URL=postgresql://neondb_owner:<password>@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Local SQLite path (fallback if DATABASE_URL is not set and USE_SQL=true)
SQL_FILE_PATH=./todos.sqlite
